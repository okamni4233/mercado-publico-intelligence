# ===============================
# Mercado Publico API config
# ===============================

# tu ticket de la API (sacarlo desde chilecompra)
MP_TICKET=your_ticket_here

# base url (no deberias cambiar esto)
MP_BASE_URL=https://api.mercadopublico.cl/servicios/v1/publico

# timeout de requests en segundos
REQUEST_TIMEOUT=30

# sleep entre requests (para no saturar la API)
SLEEP_SECONDS=0.2

# base de datos (por ahora sqlite)
DB_URL=sqlite:///./data/mercado_publico.db

# carpeta de datos
DATA_DIR=./data